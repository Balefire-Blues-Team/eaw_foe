spriteTypes = {
	# Industry: own image files in gfx/interface/special_project (copies of the base game's land images until redrawn)
	spriteType = {
		name = "GFX_specialization_industry"
		texturefile = "gfx/interface/special_project/specialization_industry.dds"
	}
	spriteType = {
		name = "GFX_mapicon_facility_specialization_industry"
		texturefile = "gfx/interface/special_project/mapicon_facility_specialization_industry.dds"
		noOfFrames = 3
	}
	spriteType = {
		name = "GFX_technology_specialization_industry"
		texturefile = "gfx/interface/special_project/technology_specialization_industry.dds"
	}
	# Arcane Sciences: own image files (copies of the base game's nuclear images until redrawn).
	# Arms and Armour, Advanced Machines and Heavy Engineering need no entry here: the mod's copies of the base game's
	# land, air and naval images sit at the same paths and replace them.
	spriteType = {
		name = "GFX_specialization_arcane"
		texturefile = "gfx/interface/special_project/specialization_arcane.dds"
	}
	spriteType = {
		name = "GFX_mapicon_facility_specialization_arcane"
		texturefile = "gfx/interface/special_project/mapicon_facility_specialization_arcane.dds"
		noOfFrames = 3
	}
	spriteType = {
		name = "GFX_technology_specialization_arcane"
		texturefile = "gfx/interface/special_project/technology_specialization_arcane.dds"
	}
	# Sprites the special project screens fall back on. The base game defines them in interface/special_projects.gfx,
	# which the mod overrides with an empty file.
	spriteType = {
		name = "GFX_facility_constructions"
		texturefile = "gfx/interface/special_project/facility_constructions.dds"
		legacy_lazy_load = no
	}
	spriteType = {
		name = "GFX_PLACEHOLDER_sp_blueprint"
		texturefile = "gfx/interface/special_project/PLACEHOLDER_UI/PLACEHOLDER_sp_blueprint.dds"
		legacy_lazy_load = no
	}
	spriteType = {
		name = "GFX_PLACEHOLDER_sp_project_icon"
		texturefile = "gfx/interface/special_project/PLACEHOLDER_UI/PLACEHOLDER_sp_project_icon.dds"
		legacy_lazy_load = no
	}
	spriteType = {
		name = "GFX_PLACEHOLDER_sp_project_picture"
		texturefile = "gfx/interface/special_project/PLACEHOLDER_UI/PLACEHOLDER_sp_project_picture.dds"
		legacy_lazy_load = no
	}
	spriteType = {
		name = "GFX_PLACEHOLDER_sp_specialization_icon"
		texturefile = "gfx/interface/special_project/PLACEHOLDER_UI/PLACEHOLDER_sp_specialization_icon.dds"
		legacy_lazy_load = no
	}
	spriteType = {
		name = "GFX_unavailable_project"
		texturefile = "gfx/interface/special_project/project_icons/sp_question_mark.dds"
		legacy_lazy_load = no
	}
	spriteType = {
